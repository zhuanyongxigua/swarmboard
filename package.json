{
  "name": "swarmboard",
  "version": "0.4.1",
  "private": true,
  "description": "An Agensh-inspired multi-agent workspace for ChatGPT Desktop: claim tasks, coordinate resources, and share progress.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:ui && tsx watch src/index.ts",
    "start": "node dist/server/index.js",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run build:ui && tsc -p tsconfig.build.json",
    "build:desktop": "npm run build:ui && node scripts/build-desktop.mjs",
    "package:desktop": "npm run build:desktop && node scripts/package-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:api": "vitest run test/api",
    "test:mcp": "vitest run test/mcp",
    "test:desktop": "npm run package:desktop && vitest run test/mcp/desktop.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run build && npm run package:desktop && npm run test:coverage && npm run test:e2e",
    "docs:screenshots": "npm run build && node scripts/capture-readme.mjs",
    "test:host": "node scripts/verify-plugin-host.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
